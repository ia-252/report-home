<div class="container">
    <div class="link-menu">
        <%= link_to "TOP", "/",class: "link" %>
        <p>/</p>
        <%= link_to "授業予定", "/schedules/index",class: "link" %> 
    </div>
    <div class="tytle">
        <h1>授業予定</h1>
    </div>
    <div class="report-table-wrapper">
                
        <div class="calendar">
            <%= month_calendar events: @reports do |date, reports| %>
                <%= date.day %>
            
                <% reports.each do |report| %>
                    <div class = "day-field">
                        <%= link_to "#{report.classTime.strftime("%H:%M")}~#{report.classSubject}", "/class-schedules/#{report.id}" ,class: "event"%>
                    </div> 
                <% end %>
        <%end%>
    </div>
</div>