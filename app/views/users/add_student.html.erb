<div class="main posts-new">
  <div class="container">
    <div class="link-menu">
      <%= link_to "TOP", "/",class: "link" %>
    </div>
    <div class="tytle">
        <h1 class="form-heading">設定</h1>
    </div>
    
    <div class="teacher users-form">
        <div class="form-body">
          <% @userT.errors.full_messages.each do |message| %>
            <div class="form-error">
              <%= message %>
            </div>
          <% end %>
            <div class="user-menu">
                <h2 class="form-heading">生徒追加</h2>
            </div>
            <div class="student">
                <%= form_tag("/user/teacher/:id/add_new_student") do %>
                    <p>担当生徒ID</p>
                    <input name="studentId">
                    <input class = "submit" type="submit" value="追加">
                <% end %>
            </div>
        </div>
    </div>
  </div>
</div>