<div class="main">
  <div class="container">
    <div class="link-menu">
        <%= link_to "TOP", "/",class: "link" %>
        <p>/</p>
        <%= link_to "生徒用ログイン", "/login_form/student",class: "link" %> 
        
    </div>
    <div class="tytle"><h1>ログイン</h1></div>
    <div class="sub-tytle">
        <%= link_to("講師用はこちら","/login_form/teacher")%>
      </div>
    <div class="form users-form">
        
            <div class="form-body">
                <% if @error_message %>
                <div class="form-error">
                    <%= @error_message %>
                </div>
                <% end %>
                
                <div class="student"><p>生徒用<p></div>
                <%= form_tag("/login/student") do %>
                <p>メールアドレス</p>
                <input name="email" value="<%= @email %>">
                <p>パスワード</p>
                <input type="password" name="password" value="<%= @password %>">
                <input class="submit" type="submit" value="ログイン">
                <% end %>
            </div>
    </div>
  </div>
</div>